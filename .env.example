# Google Drive folder ID containing per-player Lichess report folders
DRIVE_PARENT_FOLDER_ID=12PIh1S55cgjBMLpJ4G1cFJb-lAxHikqg

# Base64-encoded Google Service Account JSON (same secret used in GitHub Actions)
# OR path to local service account JSON file via GOOGLE_APPLICATION_CREDENTIALS
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS=

# GitHub Personal Access Token (with `workflow` or `actions:write` scope) to trigger workflow_dispatch
GITHUB_TOKEN=
GITHUB_REPO=ChukwumaKingsley/lichess_report_preprocessor
GITHUB_WORKFLOW_FILE=lichess_pipeline.yaml
GITHUB_BRANCH=main

# Optional Lichess API token for higher rate limits
LICHESS_TOKEN=

# ---------------------------------------------------------------------------
# Public Deployment Protection & Access Control (Optional)
# ---------------------------------------------------------------------------
# 1. Require a passcode to trigger GitHub Actions (leave empty for public triggers with rate limit)
PORTAL_TRIGGER_PASSCODE=

# 2. Grant individual revocable access keys to a subset of trusted users: "alice:key1,bob:key2"
PORTAL_USER_TOKENS=

# 3. Require a passcode to view the dashboard at all (leave empty for public read-only analytics)
PORTAL_VIEW_PASSCODE=

# 4. Restrict triggers to a specific subset of Lichess players: "Wizard-King,Real_Vick"
ALLOWED_TRIGGER_PLAYERS=

# 5. Rate limits to protect your GitHub Actions quota
TRIGGER_COOLDOWN_SECONDS=120
TRIGGER_MAX_PER_HOUR=10
